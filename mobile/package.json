{
  "name": "pandora-browser-mobile",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "cap:build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build && npx cap sync",
    "cap:ios": "next build && npx cap sync ios && npx cap open ios",
    "cap:android": "next build && npx cap sync android && npx cap open android",
    "mobile:profile:local": "node scripts/mobile/set-profile.mjs local",
    "mobile:profile:staging": "node scripts/mobile/set-profile.mjs staging",
    "mobile:profile:prod": "node scripts/mobile/set-profile.mjs production",
    "brave:dev": "node scripts/mobile/launch-brave.mjs",
    "brave:mobile": "node scripts/mobile/launch-brave.mjs --mobile"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@expo/dom-webview": "latest",
    "@expo/metro-runtime": "latest",
    "expo": "latest",
    "expo-asset": "latest",
    "expo-file-system": "latest",
    "expo-gl": "latest",
    "react-native": "latest",
    "react-native-reanimated": "latest",
    "react-native-web": "latest",
    "react-native-webview": "latest",
    "react-native-worklets": "latest"
  }
}