# ==============================================================================
# PΛND0RΛ BROWSER & FORENX FORZA - VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Skopírujte tento súbor do Vercel Dashboardu (Settings -> Environment Variables)
# alebo do .env.production pre lokálny staging.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE WEB & APPS CONFIGURATION
# ------------------------------------------------------------------------------
# Názov aplikácie a verzia
NEXT_PUBLIC_APP_NAME="PANDORA Browser"
NEXT_PUBLIC_APP_VERSION="2.0.0"

# Skutočná verejná doména vašej Vercel aplikácie.
NEXT_PUBLIC_BASE_URL="https://pandora.whoiswho.at"

# WebAuthn / Passkey Relying Party ID - nastavené na koreňovú doménu pre podporu whoiswho.at aj pandora.whoiswho.at
NEXT_PUBLIC_RP_ID="whoiswho.at"
NEXT_PUBLIC_RP_NAME="PANDORA ForenX OS"

# Telemetria & Analytika (true / false)
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# ------------------------------------------------------------------------------
# 2. SUPABASE CLOUD (PostgreSQL Databáza & Používateľská autentifikácia)
# ------------------------------------------------------------------------------
# Získate z: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Tajný administrátorský kľúč pre backend funkcie (NIKDY nezverejňovať v klientskom kóde!)
# Získate z: Supabase -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key..."

# ------------------------------------------------------------------------------
# 3. FORENSIC S3 EVIDENCE VAULT (Hetzner Cloud Object Storage / MinIO / AWS S3)
# ------------------------------------------------------------------------------
# Koncový bod S3 úložiska (pre Hetzner napr. https://hel1.your-objectstorage.com)
S3_ENDPOINT="https://hel1.your-objectstorage.com"
S3_REGION="hel1"
S3_BUCKET="forenx-vault-sk"
S3_BUCKET_NAME="forenx-vault-sk"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 4. AI MODELY & AGENTI (Mistral AI & Google Gemini)
# ------------------------------------------------------------------------------
# Primárny LLM engine pre PΛND0RΛ Copilot
# Získate z: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY="sk-mistral-your-api-key"
MISTRAL_MODEL="mistral-large-latest"
MISTRAL_API_TIMEOUT_MS="50000"

# Voliteľné sekundárne AI modely
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. PLATBY & PREDPLATNÉ (Stripe)
# ------------------------------------------------------------------------------
# Získate z: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_PAYMENTS_CLIENT_TOKEN=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. EXTERNE FORENZNÉ REGISTRE & KONEKTORY (Slovensko & EÚ)
# ------------------------------------------------------------------------------
# Register partnerov verejného sektora & WhoIsWho
WHOISWHO_API_URL="https://api.whoiswho.at"
WHOISWHO_API_KEY=""
WHOISWHO_ENABLED="1"

# IČO Atlas / Finančná správa API konektor
ICO_ATLAS_API_URL="http://2.29.52.59:8080"
ICO_ATLAS_API_KEY=""

# ForenX AI Worker (Background Task Pipeline)
FORENX_AI_WORKER_URL="https://api.whoiswho.at/forenx-ai"
FORENX_AI_WORKER_KEY=""
