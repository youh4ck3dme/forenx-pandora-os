# App Configuration
NEXT_PUBLIC_APP_NAME="PANDORA Browser"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# WebAuthn
NEXT_PUBLIC_RP_ID="localhost"
NEXT_PUBLIC_RP_NAME="PANDORA Browser"

# Features & Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# AI Configuration (Mistral & Google Gemini)
MISTRAL_API_KEY=""
MISTRAL_API_KEY_CHAT=""
MISTRAL_API_KEY_ANALYSIS=""
MISTRAL_MODEL="mistral-large-latest"
MISTRAL_API_TIMEOUT_MS="500000"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"
OPENAI_API_KEY=""

# ─── GEMINI QUALITY GATE (FORENX Independent Code Reviewer) ────────────
# Server-only Gemini Quality Gate configuration for production code review.
# NEVER set these in browser-accessible environment files.
GEMINI_QUALITY_MODEL="gemini-3.7-flash"
GEMINI_QUALITY_TIMEOUT_MS="120000"
GEMINI_QUALITY_MAX_FILES="40"
GEMINI_QUALITY_MAX_FILE_BYTES="157286"
GEMINI_QUALITY_MAX_TOTAL_CONTEXT="1048576"

# Supabase (PostgreSQL Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ForenZX MCP Hub (server-only; never prefix these with NEXT_PUBLIC_)
FORENZX_MCP_URL="http://127.0.0.1:8000"
FORENZX_MCP_API_KEY=""
FORENZX_MCP_TIMEOUT_MS="15000"
FORENZX_WEBHOOK_SECRET=""
FORENZX_PACK_ID="mobile_compromise"
FORENZX_DEFAULT_INPUT_TYPE=""

# ForenZX S3 Configuration (MUST match S3_* for presigned URL generation)
FORENZX_S3_ENDPOINT=""
FORENZX_S3_REGION="hel1"
FORENZX_S3_BUCKET="forenx-vault-sk"
FORENZX_S3_ACCESS_KEY_ID=""
FORENZX_S3_SECRET_ACCESS_KEY=""
FORENZX_PRESIGNED_EXPIRY_SECONDS="3600"

# Pandora URL for ForenZX presigned URL endpoint
PANDORA_URL=""

# S3 Object Storage (Hetzner Cloud Vault / MinIO / AWS S3)
S3_ENDPOINT=""
S3_REGION="hel1"
S3_BUCKET="forenx-vault-sk"
S3_BUCKET_NAME="forenx-vault-sk"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL=""

# Intelligence & Registry Connectors (WhoIsWho SK / ICO Atlas / AI Worker)
WHOISWHO_API_URL="https://api.whoiswho.at"
WHOISWHO_API_KEY=""
WHOISWHO_ENABLED="1"
ICO_ATLAS_API_URL="http://2.29.52.59:8080"
ICO_ATLAS_API_KEY=""
FORENX_AI_WORKER_URL="https://api.whoiswho.at/forenx-ai"
FORENX_AI_WORKER_KEY=""
FORENX_ADMIN_EMAILS=""

# Payments (only when paid plans are activated)
NEXT_PUBLIC_PAYMENTS_CLIENT_TOKEN=""

# Serverové funkcie (/api/fn). Prázdne = rovnaký origin a limit 4 MB (bezpečný aj pre Vercel).
# Zabalený klient (Electron app://): https origin servera + jeho origin v SERVER_FN_ALLOWED_ORIGINS.
NEXT_PUBLIC_SERVER_FN_ORIGIN=""
# Self-hosted (nginx /api/fn/ 34m) môže zvýšiť, najviac 33554432 (32 MiB).
NEXT_PUBLIC_SERVER_FN_MAX_BODY_BYTES=""
# Čiarkou oddelené originy pre CORS, napr. app://-. Prázdne = iba same-origin.
SERVER_FN_ALLOWED_ORIGINS=""

# ─── LOKÁLNY VÝVOJ BEZ PRIHLÁSENIA (P0-08) ───────────────────────────
# "1" = trezor (/api/vault*) prijme bez tokenu pevnú dev identitu
# (dev-investigator-001) a preskočí kontrolu vlastníctva a audit. Platí IBA pri
# `next dev`, mimo Vercelu, pre požiadavky na localhost a IBA BEZ reálnych dát
# (bez S3_* / AWS_* kľúčov a bez SUPABASE_SERVICE_ROLE_KEY) — s reálnym
# úložiskom je povinné prihlásenie. Nikdy nenastavovať na stagingu ani preview.
PANDORA_DEV_AUTH_BYPASS=""
