{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "workflow"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/hooks/*": [
        "./lib/hooks/*",
        "./hooks/*"
      ],
      "@/forensic": [
        "./lib/forza/forensic"
      ],
      "@/forensic/*": [
        "./lib/forza/forensic/*"
      ],
      "@/lib/*": [
        "./lib/forza/*",
        "./lib/*"
      ],
      "@tanstack/react-start": [
        "./lib/tanstack-start-shim.ts"
      ],
      "@tanstack/react-start/server": [
        "./lib/tanstack-start-shim.ts"
      ],
      "@tanstack/react-start/*": [
        "./lib/tanstack-start-shim.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scratch",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "supabase/functions"
  ]
}
