{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/hooks/*": ["./lib/hooks/*"],
      "@/forensic": ["./lib/forza/forensic"],
      "@/forensic/*": ["./lib/forza/forensic/*"],
      "@/lib/*": ["./lib/forza/*", "./lib/*"],
      "@tanstack/react-start": ["./lib/tanstack-start-shim.ts"],
      "@tanstack/react-start/server": ["./lib/tanstack-start-shim.ts"],
      "@tanstack/react-start/*": ["./lib/tanstack-start-shim.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scratch"
  ]
}
