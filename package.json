{
  "name": "pandora-web",
  "version": "2.0.0",
  "private": true,
  "description": "PANDORA Browser - Next.js fullstack web application",
  "author": "PΛND0RΛ Team",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "dev": "next dev",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "build:vps": "cross-env NODE_OPTIONS=--max-old-space-size=4096 STANDALONE=true next build",
    "start:vps": "node .next/standalone/server.js",
    "electron:dev": "concurrently \"next dev -p 3001\" \"wait-on http://localhost:3001 && npx tsc -p electron/tsconfig.json && npx tsc -p electron/tsconfig.preload.json && cross-env ELECTRON_START_URL=http://localhost:3001 electron dist-electron/main.mjs\"",
    "electron:build": "next build && npx tsc -p electron/tsconfig.json && npx tsc -p electron/tsconfig.preload.json && cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-builder",
    "test": "vitest",
    "test:cleanroom": "vitest run db/cleanroom/tests",
    "test:docker:proof": "tsx db/cleanroom/tests/run-docker-runtime-proof.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit": "node scripts/audit.mjs",
    "audit:ast": "node scripts/ci/ast-guard.mjs lib/ai && node scripts/ci/ast-guard.mjs app/api/forenzx && node scripts/ci/ast-guard.mjs app/api/auth/webauthn",
    "ci:guard": "node scripts/ci/ast-guard.mjs lib/ai && vitest run",
    "verify:desktop-security": "npx vitest run electron/__tests__/ && npx tsc -p electron/tsconfig.json --noEmit",
    "verify:web": "npx tsc --noEmit && npm run build && npx vitest run",
    "verify:vercel-env": "node scripts/vercel-preflight.mjs",
    "verify:production": "npx tsc --noEmit && npm run build && npm run verify:desktop-security && npx vitest run",
    "verify:vercel-deploy": "npm run verify:vercel-env -- --strict && npm run verify:production",
    "quality:gemini": "tsx scripts/gemini-quality-gate.ts",
    "test:regression:forenzx": "tsx scripts/regression/forenzx-workflow.ts"
  },
  "main": "dist-electron/main.mjs",
  "build": {
    "appId": "com.pandora.browser",
    "productName": "PANDORA Browser",
    "files": [
      "out/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.6",
    "@ai-sdk/openai": "^3.0.7",
    "@dnd-kit/core": "^6.3.1",
